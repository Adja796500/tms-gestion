APP_NAME="TMS Gestion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de donnees PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dame_erp
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Email (envoi des factures et relances). En "log", rien ne part : les messages
# sont seulement ecrits dans storage/logs. Exemple avec Gmail (mot de passe
# d'application a creer dans le compte Google > Securite) :
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=votre.adresse@gmail.com
# MAIL_PASSWORD=mot-de-passe-application
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=votre.adresse@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Devise utilisee dans toute la plateforme (FCFA par defaut, cf. classeur d'origine)
APP_CURRENCY=FCFA
