{
    "name": "dame/erp-platform",
    "type": "project",
    "description": "Plateforme de gestion ENTREPRISE DAME (stock, achats, ventes, clients, fournisseurs, facturation) - migree depuis le classeur Excel ODG vers Laravel + PostgreSQL.",
    "keywords": ["laravel", "erp", "gestion", "stock", "facturation"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "laravel/framework": "^11.31",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^3.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-3r5d-mb8f-1qw9": "Pas de correctif dans la branche Laravel 11.x (fix seulement a partir de 12.60/13.10) ; risque faible pour usage local/interne, a revoir lors d'une migration vers Laravel 12+.",
                "PKSA-m5cs-t1y6-qpcs": "Idem - pas de correctif Laravel 11.x disponible.",
                "PKSA-mdq4-51ck-6kdq": "Idem - pas de correctif Laravel 11.x disponible."
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
